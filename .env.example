# =======================================================
# Configurações do Agente de Atendimento - Empório da Música
# =======================================================

# Provedor do Modelo: 'openrouter' (padrão único para texto, visão e áudio)
LLM_PROVIDER=openrouter

# Chave de API do OpenRouter
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Modelo LLM Principal (Chat e Raciocínio)
# Exemplos recomendados:
# - openai/gpt-4o-mini (rápido, excelente aderência a JSON/Tools, ótimo custo-benefício)
# - anthropic/claude-3.5-sonnet (altíssima precisão de raciocínio)
# - meta-llama/llama-3.3-70b-instruct (open source de alta performance)
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.2

# Modelo de Visão (para análise de imagens de produtos/instrumentos enviadas por clientes)
VISION_MODEL=openai/gpt-4o-mini

# Armazenamento e Histórico (LGPD)
# TTL em dias para expiração do histórico de conversas (default: 7 dias)
HISTORY_TTL_DAYS=7

# Buffer de Mensagens (Debounce)
# Tempo em segundos para acumular mensagens sequenciais do cliente antes de processar
MESSAGE_BUFFER_SECONDS=3

# Configurações do Servidor FastAPI
API_HOST=0.0.0.0
API_PORT=8000
