# =======================================================
# Configurações do Agente de Atendimento - Empório da Música
# =======================================================

# Provedor do Modelo: 'openai' ou 'openrouter'
LLM_PROVIDER=openai

# Chaves de API
OPENAI_API_KEY=sua_chave_openai_aqui
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Modelo LLM
# Para OpenAI ex: gpt-4o, gpt-4o-mini
# Para OpenRouter ex: anthropic/claude-3.5-sonnet, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Armazenamento e Histórico (LGPD)
# TTL em dias para expiração do histórico de conversas (default: 7 dias)
HISTORY_TTL_DAYS=7

# Redis (Opcional - caso não configurado, utiliza cache/banco SQLite em memória com TTL automático)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Configurações do Servidor FastAPI
API_HOST=0.0.0.0
API_PORT=8000
